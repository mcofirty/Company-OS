# Copier en .env.production (jamais versionné) et remplir. Aucun secret dans NEXT_PUBLIC_*.
POSTGRES_PASSWORD=
# URL publiques (HTTPS en production : refus de démarrer sinon).
WEB_ORIGIN=https://hq.example.com
PUBLIC_API_URL=https://api.example.com
# Authentification : OIDC (multi-utilisateurs) …
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
# … ou jeton unique pour un usage personnel (≥ 32 caractères).
API_ACCESS_TOKEN=
# Traces OpenTelemetry (optionnel), ex. http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Publication des ports derrière le reverse proxy TLS.
API_PUBLISH=127.0.0.1:4000
WEB_PUBLISH=127.0.0.1:3000
IMAGE_TAG=latest

# Masque l'organisation de démonstration (données fictives). Mettre false pour une démo.
HIDE_DEMO_ORG=true
# Chiffrement des jetons de connecteurs MCP : `openssl rand -base64 32`, ne jamais la changer.
CONNECTOR_SECRET_KEY=

# Connexion propriétaire (un seul humain : mot de passe + code TOTP du téléphone).
# Générée par `bash infra/deploy/set-login.sh` ; exclusive de API_ACCESS_TOKEN.
OWNER_PASSWORD_HASH=
OWNER_TOTP_SECRET=
OWNER_SESSION_SECRET=
# Proxys de confiance devant l'API (Caddy : 1) pour limiter les essais par adresse réelle.
TRUST_PROXY=

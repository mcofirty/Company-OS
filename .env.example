# EXEMPLE — ne contient aucun secret réel. Copier en .env (jamais commité).
NODE_ENV=development
# demo | live — le mode live n'est pas encore implémenté (refus de démarrer).
APP_MODE=demo
DATABASE_URL=postgresql://companyos:companyos@localhost:5432/companyos
DATABASE_URL_TEST=postgresql://companyos:companyos@localhost:5432/companyos_test
API_PORT=4000
API_HOST=127.0.0.1
# Origines autorisées (CORS), séparées par des virgules. Ajouter l'URL Vercel pour l'accès distant.
WEB_ORIGIN=http://localhost:3000
# Jeton administrateur pour exposer l'API (Cloudflare Tunnel). VIDE = accès dev localhost uniquement.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_ACCESS_TOKEN=
# Production multi-utilisateurs : OIDC (Keycloak, Auth0, Entra ID, Zitadel…). Les trois ensemble.
# Client web PUBLIC (PKCE, sans secret) ; jetons d'accès JWT avec l'audience ci-dessous.
# Comptes accordés explicitement : pnpm users grant --sub <sub> --name "Nom" --role admin|operator|viewer
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_SCOPE=openid profile email
# Requêtes /v1 par minute et par adresse IP.
RATE_LIMIT_PER_MIN=1200
WEB_PORT=3000
# Variables publiques côté navigateur : aucun secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Worker démo : l'autopilote crée périodiquement des tâches DEMO étiquetées (provenance demo).
DEMO_AUTOPILOT=true
DEMO_AUTOPILOT_INTERVAL_MS=7000
WORKER_CONCURRENCY=4
# Orchestration des runs : temporal (durable, défaut) | inline (tests, sans serveur Temporal)
ORCHESTRATOR=temporal
TEMPORAL_ADDRESS=localhost:7233
# Ne pas démarrer LIVE tant que clés, politiques et outils ne sont pas configurés (M2).
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=
ALLOW_EXTERNAL_SIDE_EFFECTS=false
DEFAULT_MONTHLY_BUDGET_USD=50
LOG_LEVEL=info

# Connecteurs MCP : clé AES-256 (base64, 32 octets) chiffrant les jetons — `openssl rand -base64 32`.
# Sans clé, seuls des connecteurs sans jeton peuvent être ajoutés.
CONNECTOR_SECRET_KEY=
# Développement uniquement : autorise http:// et les adresses privées (refusé en production).
CONNECTOR_ALLOW_PRIVATE_NETWORK=false

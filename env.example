# EXEMPLE — ne contient aucun secret réel
NODE_ENV=development
APP_MODE=demo
DATABASE_URL=postgresql://companyos:companyos_local_only@localhost:5432/companyos?schema=public
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
WEB_PORT=3000
API_PORT=4000
TEMPORAL_ADDRESS=localhost:7233
# Ne pas démarrer LIVE tant que clés, politiques et outils ne sont pas configurés
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ALLOW_EXTERNAL_SIDE_EFFECTS=false
DEFAULT_MONTHLY_BUDGET_USD=50
LOG_LEVEL=info

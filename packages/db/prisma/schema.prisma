generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Mode {
  demo
  live
}

model Company {
  id        String   @id
  name      String
  mode      Mode
  createdAt DateTime @default(now())
  agents    Agent[]
  events    Event[]
}

/// État courant d'un agent (lecture rapide). Toujours modifié dans la même
/// transaction que l'événement qui le justifie.
model Agent {
  id        String   @id
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  role      String
  status    String   @default("idle")
  activity  String?
  posX      Int
  posY      Int
  mode      Mode
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

/// Journal d'événements append-only : source de vérité de ce qui s'est passé.
model Event {
  seq            BigInt   @id @default(autoincrement())
  id             String   @unique @db.Uuid
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  type           String
  mode           Mode
  actorKind      String
  actorId        String?
  payload        Json
  idempotencyKey String?  @unique
  occurredAt     DateTime @default(now())
  outbox         OutboxMessage?

  @@index([companyId, seq])
}

/// Transactional outbox : écrit avec l'événement, publié ensuite vers le temps réel.
model OutboxMessage {
  id          BigInt    @id @default(autoincrement())
  eventSeq    BigInt    @unique
  event       Event     @relation(fields: [eventSeq], references: [seq])
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)

  @@index([publishedAt, id])
}

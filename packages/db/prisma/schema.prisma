generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Conventions (docs/03) : dates UTC timestamptz, org_id sur toutes les tables métier,
// noms de tables snake_case. Les identifiants lisibles (agents, départements, outils)
// sont des slugs stables ; les objets générés (tâches, runs, invocations, événements) des UUID.

enum Mode {
  demo
  live
}

enum Provenance {
  demo
  live
  imported
}

enum MemberRole {
  admin
  operator
  viewer
}

model Organization {
  id             String   @id @db.Uuid
  name           String
  mode           Mode
  timezone       String   @default("Europe/Paris")
  currency       String   @default("USD")
  /// Dernier numéro de séquence attribué : sert de compteur ET de verrou de ligne par org.
  lastSeq        BigInt   @default(0) @map("last_seq")
  killSwitch     Boolean  @default(false) @map("kill_switch")
  /// Organisation live : outils de démonstration (données fictives) autorisés ? Non par défaut.
  allowDemoTools Boolean  @default(false) @map("allow_demo_tools")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships Membership[]
  departments Department[]
  agents      Agent[]
  tasks       Task[]
  events      EventLog[]

  @@map("organizations")
}

model User {
  id              String       @id @db.Uuid
  providerSubject String       @unique @map("provider_subject")
  displayName     String       @map("display_name")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships     Membership[]

  @@map("users")
}

model Membership {
  orgId  String       @map("org_id") @db.Uuid
  userId String       @map("user_id") @db.Uuid
  role   MemberRole
  org    Organization @relation(fields: [orgId], references: [id])
  user   User         @relation(fields: [userId], references: [id])

  @@id([orgId, userId])
  @@map("memberships")
}

model Department {
  id             String       @id
  orgId          String       @map("org_id") @db.Uuid
  org            Organization @relation(fields: [orgId], references: [id])
  name           String
  color          String
  roomId         String       @map("room_id")
  managerAgentId String?      @map("manager_agent_id")
  capacity       Int
  agents         Agent[]

  @@index([orgId])
  @@map("departments")
}

model Agent {
  id              String       @id
  orgId           String       @map("org_id") @db.Uuid
  org             Organization @relation(fields: [orgId], references: [id])
  name            String
  title           String
  role            String
  departmentId    String       @map("department_id")
  department      Department   @relation(fields: [departmentId], references: [id])
  managerId       String?      @map("manager_id")
  avatarId        String       @map("avatar_id")
  deskAnchor      String       @map("desk_anchor")
  status          String       @default("draft")
  activity        String       @default("idle")
  currentTaskId   String?      @map("current_task_id") @db.Uuid
  lastTaskEndedAt DateTime?    @map("last_task_ended_at") @db.Timestamptz(3)
  provenance      Provenance
  createdBy       String       @map("created_by")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(3)
  version         Int          @default(1)
  activeVersion   Int          @default(1) @map("active_version")
  /// Fiche (affichage) : compétences et tâches habituelles, saisies par un administrateur humain.
  skills          String[]     @default([])
  routines        String[]     @default([])

  grants      AgentToolGrant[]
  versions    AgentVersion[]
  tasks       Task[]
  runs        AgentRun[]
  invocations ToolInvocation[]

  /// Deux agents ne peuvent pas occuper le même poste.
  @@unique([orgId, deskAnchor])
  @@index([orgId, departmentId, status])
  @@map("agents")
}

/// Instructions et politique modèle versionnées, immuables une fois activées (docs/04 §4, docs/13 §9).
model AgentVersion {
  id            String   @id @db.Uuid
  agentId       String   @map("agent_id")
  agent         Agent    @relation(fields: [agentId], references: [id])
  version       Int
  promptVersion String   @map("prompt_version")
  instructions  String
  goal          String
  /// { model, effort, maxTokens }
  modelPolicy   Json     @map("model_policy")
  /// { maxSteps, maxDurationMs, maxCostMicros }
  limits        Json
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([agentId, version])
  @@map("agent_versions")
}

/// Autorisation explicite agent -> outil -> actions (jamais héritée du nom du rôle).
model AgentToolGrant {
  agentId   String   @map("agent_id")
  agent     Agent    @relation(fields: [agentId], references: [id])
  toolId    String   @map("tool_id")
  tool      Tool     @relation(fields: [toolId], references: [id])
  actions   String[]
  grantedBy String   @map("granted_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([agentId, toolId])
  @@map("agent_tool_grants")
}

model Tool {
  id          String           @id
  orgId       String?          @map("org_id") @db.Uuid
  name        String
  code        String
  category    String
  color       String
  actions     Json
  status      String           @default("healthy")
  /**
   * Connecteur retiré : la ligne reste (historique des invocations), la machine disparaît.
   */
  archivedAt  DateTime?        @map("archived_at") @db.Timestamptz(3)
  grants      AgentToolGrant[]
  invocations ToolInvocation[]
  connector   Connector?

  @@map("tools")
}

model Task {
  id             String       @id @db.Uuid
  orgId          String       @map("org_id") @db.Uuid
  org            Organization @relation(fields: [orgId], references: [id])
  kind           String
  title          String
  description    String
  status         String
  priority       Int          @default(3)
  agentId        String       @map("agent_id")
  agent          Agent        @relation(fields: [agentId], references: [id])
  requesterType  String       @map("requester_type")
  requesterId    String       @map("requester_id")
  correlationId  String       @map("correlation_id") @db.Uuid
  provenance     Provenance
  idempotencyKey String?      @map("idempotency_key")
  attempts       Int          @default(0)
  version        Int          @default(1)
  createdAt      DateTime     @map("created_at") @db.Timestamptz(3)
  startedAt      DateTime?    @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime?    @map("ended_at") @db.Timestamptz(3)
  resultSummary  String?      @map("result_summary")
  resultRef      String?      @map("result_ref")
  failureCode    String?      @map("failure_code")
  /// Délégation : tâche parente (DAG, profondeur bornée, cycles refusés côté service).
  parentTaskId   String?      @map("parent_task_id") @db.Uuid
  depth          Int          @default(0)
  /// Plafond de coût de CETTE exécution (mission récurrente), en micro-USD.
  costCapMicros  Int?         @map("cost_cap_micros")
  /// Mission récurrente d'origine.
  scheduleId     String?      @map("schedule_id") @db.Uuid
  /// « Demander une suite » : mission précédente dont celle-ci reprend le résultat.
  followUpOf     String?      @map("follow_up_of") @db.Uuid

  runs        AgentRun[]
  invocations ToolInvocation[]

  @@unique([orgId, idempotencyKey])
  @@index([orgId, status, createdAt])
  @@map("tasks")
}

model AgentRun {
  id             String     @id @db.Uuid
  orgId          String     @map("org_id") @db.Uuid
  agentId        String     @map("agent_id")
  agent          Agent      @relation(fields: [agentId], references: [id])
  taskId         String     @map("task_id") @db.Uuid
  task           Task       @relation(fields: [taskId], references: [id])
  provider       String
  model          String?
  status         String
  stepCount      Int        @default(0) @map("step_count")
  startedAt      DateTime   @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime?  @map("ended_at") @db.Timestamptz(3)
  outcomeSummary String?    @map("outcome_summary")
  failureCode    String?    @map("failure_code")
  provenance     Provenance
  /// Identifiant de l'événement agent.run.started (chaîne de causalité).
  startEventId   String     @map("start_event_id") @db.Uuid
  agentVersion   Int        @default(1) @map("agent_version")
  llmCalls       Int        @default(0) @map("llm_calls")
  inputTokens    Int        @default(0) @map("input_tokens")
  outputTokens   Int        @default(0) @map("output_tokens")
  costMicros     Int        @default(0) @map("cost_micros")
  costSource     String     @default("none") @map("cost_source")
  workflowId     String?    @map("workflow_id")

  usages LlmUsage[]

  invocations ToolInvocation[]

  @@index([taskId, startedAt])
  @@map("agent_runs")
}

model ToolInvocation {
  id             String     @id @db.Uuid
  orgId          String     @map("org_id") @db.Uuid
  toolId         String     @map("tool_id")
  tool           Tool       @relation(fields: [toolId], references: [id])
  agentRunId     String     @map("agent_run_id") @db.Uuid
  agentRun       AgentRun   @relation(fields: [agentRunId], references: [id])
  agentId        String     @map("agent_id")
  agent          Agent      @relation(fields: [agentId], references: [id])
  taskId         String     @map("task_id") @db.Uuid
  task           Task       @relation(fields: [taskId], references: [id])
  action         String
  actionKind     String     @map("action_kind")
  risk           String
  status         String
  redactedInput  Json       @map("redacted_input")
  safeSummary    String?    @map("safe_summary")
  durationMs     Int?       @map("duration_ms")
  idempotencyKey String     @map("idempotency_key")
  attempt        Int        @default(1)
  correlationId  String     @map("correlation_id") @db.Uuid
  provenance     Provenance
  requestedAt    DateTime   @map("requested_at") @db.Timestamptz(3)
  startedAt      DateTime?  @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime?  @map("ended_at") @db.Timestamptz(3)
  errorCode      String?    @map("error_code")

  @@unique([orgId, idempotencyKey])
  @@index([orgId, status, requestedAt])
  @@map("tool_invocations")
}

/// Usage LLM par appel (tokens mesurés par le fournisseur, coût estimé depuis la grille versionnée).
model LlmUsage {
  id                  String   @id @db.Uuid
  orgId               String   @map("org_id") @db.Uuid
  agentRunId          String   @map("agent_run_id") @db.Uuid
  agentRun            AgentRun @relation(fields: [agentRunId], references: [id])
  agentId             String   @map("agent_id")
  step                Int
  provider            String
  model               String
  inputTokens         Int      @map("input_tokens")
  outputTokens        Int      @map("output_tokens")
  cacheReadTokens     Int      @map("cache_read_tokens")
  cacheWriteTokens    Int      @map("cache_write_tokens")
  costMicros          Int?     @map("cost_micros")
  currency            String   @default("USD")
  measuredOrEstimated String   @map("measured_or_estimated")
  pricingVersion      String   @map("pricing_version")
  stopReason          String   @map("stop_reason")
  createdAt           DateTime @map("created_at") @db.Timestamptz(3)

  /// Un appel par (run, étape) : une activité rejouée ne compte pas deux fois.
  @@unique([agentRunId, step])
  @@index([orgId, createdAt])
  @@map("llm_usage")
}

/// Budgets par scope (org, agent), en micro-dollars. hard_stop bloque les nouveaux appels.
model Budget {
  id             String    @id @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  scopeType      String    @map("scope_type")
  scopeId        String    @map("scope_id")
  period         String    @default("month")
  limitMicros    Int       @map("limit_micros")
  usedMicros     Int       @default(0) @map("used_micros")
  reservedMicros Int       @default(0) @map("reserved_micros")
  hardStop       Boolean   @default(true) @map("hard_stop")
  alertThreshold Float     @default(0.8) @map("alert_threshold")
  alertedAt      DateTime? @map("alerted_at") @db.Timestamptz(3)
  /// Début de la période en cours (1er du mois, UTC) : remise à zéro mensuelle de usedMicros.
  periodStart    DateTime  @default(now()) @map("period_start") @db.Timestamptz(3)

  @@unique([orgId, scopeType, scopeId, period])
  @@map("budgets")
}

/// Demandes de validation humaine (docs/05 §5). Une décision est terminale et versionnée.
model ApprovalRequest {
  id             String    @id @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  kind           String
  status         String    @default("pending")
  agentId        String    @map("agent_id")
  taskId         String?   @map("task_id") @db.Uuid
  invocationId   String?   @unique @map("invocation_id") @db.Uuid
  toolId         String?   @map("tool_id")
  action         String?
  riskReason     String    @map("risk_reason")
  safePreview    Json      @map("safe_preview")
  /// Données complètes de la proposition (côté serveur uniquement).
  payload        Json
  idempotencyKey String    @map("idempotency_key")
  requestedAt    DateTime  @map("requested_at") @db.Timestamptz(3)
  deadlineAt     DateTime  @map("deadline_at") @db.Timestamptz(3)
  reviewedBy     String?   @map("reviewed_by")
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(3)
  decisionReason String?   @map("decision_reason")
  version        Int       @default(1)

  @@unique([orgId, idempotencyKey])
  @@index([orgId, status, requestedAt])
  @@map("approval_requests")
}

/// Réunion = workflow collaboratif borné (docs/04 §7).
model Meeting {
  id               String               @id @db.Uuid
  orgId            String               @map("org_id") @db.Uuid
  topic            String
  status           String
  roomId           String               @map("room_id")
  initiatorAgentId String               @map("initiator_agent_id")
  taskId           String?              @map("task_id") @db.Uuid
  invocationId     String?              @unique @map("invocation_id") @db.Uuid
  startedAt        DateTime?            @map("started_at") @db.Timestamptz(3)
  endedAt          DateTime?            @map("ended_at") @db.Timestamptz(3)
  summary          String?
  decisions        Json                 @default("[]")
  taskIdsCreated   String[]             @map("task_ids_created")
  participants     MeetingParticipant[]

  @@index([orgId, status])
  @@map("meetings")
}

model MeetingParticipant {
  meetingId  String    @map("meeting_id") @db.Uuid
  meeting    Meeting   @relation(fields: [meetingId], references: [id])
  agentId    String    @map("agent_id")
  seatAnchor String    @map("seat_anchor")
  role       String
  joinedAt   DateTime  @map("joined_at") @db.Timestamptz(3)
  leftAt     DateTime? @map("left_at") @db.Timestamptz(3)

  @@id([meetingId, agentId])
  @@map("meeting_participants")
}

/// Alertes persistées (docs/10 §5) : une par événement source (id = eventId), acquittables.
model Alert {
  id           String    @id @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  level        String
  title        String
  resourceType String    @map("resource_type")
  resourceId   String    @map("resource_id")
  eventSeq     BigInt    @map("event_seq")
  createdAt    DateTime  @map("created_at") @db.Timestamptz(3)
  ackedAt      DateTime? @map("acked_at") @db.Timestamptz(3)
  ackedBy      String?   @map("acked_by")

  @@index([orgId, ackedAt, eventSeq])
  @@map("alerts")
}

/// Journal append-only : source de vérité de ce qui s'est passé. seq contigu par org.
model EventLog {
  id               String       @id @db.Uuid
  orgId            String       @map("org_id") @db.Uuid
  org              Organization @relation(fields: [orgId], references: [id])
  seq              BigInt
  type             String
  aggregateType    String       @map("aggregate_type")
  aggregateId      String       @map("aggregate_id")
  aggregateVersion Int          @map("aggregate_version")
  correlationId    String       @map("correlation_id") @db.Uuid
  causationId      String?      @map("causation_id") @db.Uuid
  actorKind        String       @map("actor_kind")
  actorId          String       @map("actor_id")
  provenance       Provenance
  classification   String
  payload          Json
  schemaVersion    Int          @map("schema_version")
  occurredAt       DateTime     @map("occurred_at") @db.Timestamptz(3)
  outbox           Outbox?

  @@unique([orgId, seq])
  @@index([correlationId])
  @@map("event_log")
}

/// Transactional outbox, écrite dans la même transaction que l'événement.
model Outbox {
  id            BigInt    @id @default(autoincrement())
  orgId         String    @map("org_id") @db.Uuid
  eventId       String    @unique @map("event_id") @db.Uuid
  event         EventLog  @relation(fields: [eventId], references: [id])
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("outbox")
}

model IdempotencyKey {
  orgId       String   @map("org_id") @db.Uuid
  key         String
  operation   String
  responseRef String   @map("response_ref")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([orgId, key, operation])
  @@map("idempotency_keys")
}

/// Documents enregistrés par les agents (rapports, notes) : contenu réel, consultable et
/// téléchargeable dans le cockpit. Jamais de secret (contenu rédigé avant stockage).
model Document {
  id        String   @id @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  agentId   String   @map("agent_id")
  taskId    String?  @map("task_id") @db.Uuid
  title     String
  content   String
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  @@index([orgId, createdAt])
  @@index([taskId])
  @@map("documents")
}

/// Connecteur MCP ajouté par un administrateur (docs/05 §11). Le jeton est chiffré (AES-256-GCM).
model Connector {
  id           String          @id @db.Uuid
  orgId        String          @map("org_id") @db.Uuid
  /**
   * Machine-outil associée (`mcp-xxxxxxxx`).
   */
  toolId       String          @unique @map("tool_id")
  tool         Tool            @relation(fields: [toolId], references: [id])
  name         String
  url          String
  /**
   * Jeton chiffré (v1:iv:tag:données, base64) ; jamais renvoyé par l'API.
   */
  secretSealed String?         @map("secret_sealed")
  /**
   * En-tête recevant le jeton (Authorization: Bearer par défaut).
   */
  authHeader   String          @default("authorization") @map("auth_header")
  /// Application du catalogue (github, notion, zapier…) ; null = serveur MCP libre.
  app          String?
  /// token | oauth | url (adresse secrète) | none
  authKind     String          @default("token") @map("auth_kind")
  /// Adresse complète chiffrée quand elle contient un secret (Zapier, Make, n8n) ; `url` = version affichable.
  urlSealed    String?         @map("url_sealed")
  /// OAuth : { clientInformation, tokens } chiffrés (renouvellement automatique).
  oauthSealed  String?         @map("oauth_sealed")
  status       String          @default("healthy")
  lastError    String?         @map("last_error")
  lastSyncAt   DateTime?       @map("last_sync_at") @db.Timestamptz(3)
  createdBy    String          @map("created_by")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  removedAt    DateTime?       @map("removed_at") @db.Timestamptz(3)
  tools        ConnectorTool[]

  @@index([orgId])
  @@map("connectors")
}

/// Outil découvert sur un serveur MCP, avec la politique choisie par l'administrateur.
model ConnectorTool {
  connectorId  String    @map("connector_id") @db.Uuid
  connector    Connector @relation(fields: [connectorId], references: [id])
  /**
   * Nom d'action côté plateforme (assaini, ≤ 48 caractères).
   */
  action       String
  /**
   * Nom exact côté serveur MCP.
   */
  remoteName   String    @map("remote_name")
  description  String
  inputSchema  Json      @map("input_schema")
  /**
   * read : exécution directe ; approval : validation humaine à chaque appel ; disabled.
   */
  policy       String    @default("approval")
  /**
   * Annotation du serveur (readOnlyHint) — indicative, jamais suffisante seule.
   */
  readOnlyHint Boolean   @default(false) @map("read_only_hint")
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@id([connectorId, action])
  @@map("connector_tools")
}

/// Mission récurrente (planification décidée par un humain) : déclenchée par le worker.
model Schedule {
  id            String    @id @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  agentId       String    @map("agent_id")
  title         String
  instructions  String
  /// daily | weekly | monthly
  frequency     String
  hour          Int
  minute        Int
  /// 1 = lundi … 7 = dimanche (hebdomadaire)
  weekday       Int?
  /// 1 … 28 (mensuelle)
  monthDay      Int?      @map("month_day")
  timezone      String    @default("Europe/Paris")
  /// Plafond de coût par exécution (micro-USD).
  maxCostMicros Int       @map("max_cost_micros")
  enabled       Boolean   @default(true)
  nextRunAt     DateTime  @map("next_run_at") @db.Timestamptz(3)
  lastRunAt     DateTime? @map("last_run_at") @db.Timestamptz(3)
  lastTaskId    String?   @map("last_task_id") @db.Uuid
  runCount      Int       @default(0) @map("run_count")
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([enabled, nextRunAt])
  @@index([orgId])
  @@map("schedules")
}

/// Notifications de l'organisation (téléphone / email via ntfy) : adresse chiffrée.
model NotificationSetting {
  orgId       String   @id @map("org_id") @db.Uuid
  /// URL du sujet ntfy (https://ntfy.sh/mon-sujet-secret), chiffrée (AES-256-GCM).
  urlSealed   String   @map("url_sealed")
  /// Jeton d'accès ntfy facultatif, chiffré.
  tokenSealed String?  @map("token_sealed")
  /// Email de transfert facultatif (fonction email de ntfy).
  email       String?
  /// Événements notifiés : approval, completed, failed, schedule
  events      String[]
  enabled     Boolean  @default(true)
  updatedBy   String   @map("updated_by")
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("notification_settings")
}

/// Connexion OAuth en cours (« Se connecter avec … ») : 10 minutes, usage unique.
model OAuthSession {
  state      String   @id
  orgId      String   @map("org_id") @db.Uuid
  actorId    String   @map("actor_id")
  app        String?
  name       String
  serverUrl  String   @map("server_url")
  /// { codeVerifier, clientInformation } chiffrés.
  dataSealed String?  @map("data_sealed")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)


{
  "name": "@company-os/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy && prisma generate",
    "migrate:dev": "prisma migrate dev",
    "seed": "tsx src/seed-cli.ts",
    "users": "tsx src/access-cli.ts",
    "live:init": "tsx src/live-cli.ts",
    "ops": "tsx src/ops/backup-cli.ts",
    "reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1"
  },
  "dependencies": {
    "@company-os/agents": "workspace:*",
    "@company-os/contracts": "workspace:*",
    "@company-os/policies": "workspace:*",
    "@company-os/world": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1"
  }
}

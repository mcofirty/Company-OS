{
  "name": "company-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @company-os/api --filter @company-os/worker --filter @company-os/web dev",
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "db:migrate": "pnpm --filter @company-os/db migrate",
    "db:seed": "pnpm --filter @company-os/db seed",
    "users": "pnpm --filter @company-os/db users",
    "live:init": "pnpm --filter @company-os/db live:init",
    "db:backup": "pnpm --filter @company-os/db ops backup",
    "db:restore": "pnpm --filter @company-os/db ops restore",
    "db:verify": "pnpm --filter @company-os/db ops verify",
    "db:reset": "pnpm --filter @company-os/db reset",
    "test:contracts": "vitest run packages/contracts packages/world",
    "test:integration": "vitest run packages/db apps",
    "db:generate": "pnpm --filter @company-os/db generate",
    "agent:live-smoke": "pnpm --filter @company-os/worker live-smoke",
    "backend:start": "pnpm --parallel --filter @company-os/api --filter @company-os/worker start"
  },
  "devDependencies": {
    "@company-os/agents": "workspace:*",
    "@company-os/contracts": "workspace:*",
    "@company-os/db": "workspace:*",
    "@company-os/policies": "workspace:*",
    "@company-os/tools": "workspace:*",
    "@company-os/world": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "zod": "4.6.7"
  }
}
